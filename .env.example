# Copy this file to .env and fill in what you need. Every key is optional:
# without them Finwise runs fully in demo mode (simulated market, rules-based coach).

# Claude API key for the AI coach — create one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used by the coach (default: claude-opus-5-5; claude-sonnet-5-5 costs about half)
ANTHROPIC_MODEL=
# Daily caps on Claude calls (past them the coach switches to demo mode)
COACH_USER_DAILY_LIMIT=40
COACH_GLOBAL_DAILY_LIMIT=300

# Real-time quotes and real news — free key at https://finnhub.io
FINNHUB_API_KEY=
# Optional fallback for European/Asian quotes — https://twelvedata.com
TWELVEDATA_API_KEY=

# Session signing secret (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The account that signs up with this email becomes admin
ADMIN_EMAIL=

# Shared demo account, rebuilt at every start (set SEED_DEMO=false to disable)
SEED_DEMO=true
DEMO_EMAIL=demo@finwise.app
DEMO_PASSWORD=finwise-demo

PORT=3000
